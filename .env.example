# Neon Database Connection Environment Variables
# Copy this file to .env or set these in your hosting environment (Render, Railway, Heroku, etc.)

SPRING_DATASOURCE_URL=jdbc:postgresql://ep-your-subdomain.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

